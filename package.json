{
  "name": "fastify-ata-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Fastify API where one JSON Schema gives the validation, the types and the OpenAPI document, validated by ata-validator",
  "scripts": {
    "dev": "node --import tsx --watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "test": "vitest run",
    "doc": "node --import tsx scripts/doc.ts",
    "measure": "node --import tsx scripts/measure.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.1",
    "ata-validator": "^1.47.0",
    "fastify": "^5.12.5",
    "fastify-ata": "^0.9.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
